+void
+sweet_gpu_wait_settled(uint32_t ms)
+{
+	uint32_t waited = 0;
+	while (adreno_running && waited < ms) {
+		sleep_ms(50);
+		waited += 50;
+	}
+	if (waited) {
+		printf("SWEET GPU: a program waited %u ms for the GPU bring-up (%s)\n", waited,
+		    gpu_kept ? "kept on" : adreno_running ? "still running" : "not kept");
+	}
