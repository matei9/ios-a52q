+#define HFI_MSG_CMD             0
+#define HFI_V1_MSG_ACK          2
+#define H2F_MSG_INIT            0
+#define H2F_MSG_FW_VER          1
+#define H2F_MSG_BW_VOTE_TBL     3
+#define H2F_MSG_PERF_TBL        4
