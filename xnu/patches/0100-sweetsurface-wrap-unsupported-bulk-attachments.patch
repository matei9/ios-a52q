+	case 6:         /* WrapClientImage */
+	case 7:         /* WrapClientMemory */
+		/*
+		 * Not supported, and it must say so: with "success" and a zeroed result CoreAnimation's
+		 * OpenGL ES renderer took a surface with no shared state and read its bulk attachments at
+		 * address 0x30 (boot 0099, backboardd SIGSEGV in IOSurfaceClientGetBulkAttachments via
+		 * CA::WindowServer::IOSurface::wrap_buffer). HackiOS's IOSurface answers Unsupported too,
