--- /dev/null
+++ b/bsd/dev/sweet_adreno.c
@@ -0,0 +1,575 @@
+/*
+ * SWEET/a52q: the Adreno 618 (A52, SM7125 "atoll"; same GPU block as sweet's SM7150), woken step by step.
+ *
+ * Ported from HackiOS bsd/dev/redwood_adreno.c (Adreno 642L, POCO X5 Pro) by OOSEX GANG,
+ * https://github.com/oosexgang/hackios-xnu-kernel, APSL 2.0: the staged method (reads before
+ * writes, each step announcing what it is about to touch, a boot-arg choosing how far to go),
+ * the cmd-db reader and the step structure are theirs; addresses and the a618/a630-family
+ * differences are from the A52's live device tree and its kernel source (~/sm7125):
+ * drivers/clk/qcom/{gcc-atoll,gpucc-sdmmagpie}.c, drivers/gpu/msm (kgsl) and Linux
+ * drivers/gpu/drm/msm/adreno/a6xx_gmu.c with registers/adreno/a6xx{,_gmu}.xml.
+ *
+ * Boot-arg sweetgpu=N performs steps 1..N (default 0: nothing is touched), in a kernel thread
+ * that starts sweetgpudelay seconds (default 60) after boot so that the system and the
+ * persistent log are up first. Before an access no earlier boot has survived, the step waits
+ * sweetgpupause ms (default 1500): the log is written to storage once a second, so after a
+ * silent reset its last line says what was being touched.
+ *
+ *   1  reads   the GPU's clocks in the global clock controller; its RPMh rails by name
+ *   2  reads   the GPU speed-bin fuse
+ *   3  writes  gcc_gpu_cfg_ahb on (the GPU clock controller's register clock); reads that controller
+ *   4  writes  the CX power switch on (gpu_cx_gdsc): GMU, bus interface, the GPU's SMMU
+ *   5  writes  the GPU's bus clocks, the GMU clock to 200 MHz and its branches on
+ *   6  reads   the first registers of the GPU block: the GMU (its always-on counter must count),
+ *              the VBIF (a618 is an a630-family core: VBIF, not the GBIF of a640+), CX misc
+ *
+ * Next stages (not here yet, in HackiOS order): RSCC/PDC (the a618 GMU's own RPMh path, whose
+ * sequence memory the kernel programs on pre-a650 parts), the GPU SMMU (kgsl iommu), TrustZone
+ * zap shader (a615_zap, PAS id 13), GMU firmware a618_gmu.bin and HFI, SQE a630_sqe.fw, ring.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <mach/mach_time.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_adreno_init(void);
+
+static uint32_t last_step, pause_ms = 1500;
+static uint32_t step;
+static int adreno_chan;
+
+static void
+sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&adreno_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- register access (HackiOS: one plain load or store, never a compiler-chosen form) ---- */
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static uint32_t __attribute__((noinline))
+rd8(vm_offset_t address)
+{
+	uint32_t value;
+	__asm__ volatile ("ldrb %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+struct block {
+	const char *name;
+	uint32_t phys, size;
+	vm_offset_t base;
+};
+
+static void
+need(struct block *b)
+{
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+}
+
+/* Give the log time to reach storage before an access of the newest step. */
+static void
+hold(void)
+{
+	if (step == last_step && pause_ms) {
+		sleep_ms(pause_ms);
+	}
+}
+
+static void
+announce(const char *what)
+{
+	printf("SWEET GPU: step %u: %s\n", step, what);
+	hold();
+}
+
+static uint32_t
+get(struct block *b, const char *name, uint32_t offset)
+{
+	need(b);
+	if (step == last_step) {
+		printf("SWEET GPU: %u: about to read %s %s at %#x\n", step, b->name, name, b->phys + offset);
+		hold();
+	}
+	uint32_t value = rd(b->base + offset);
+	printf("SWEET GPU: %u: %s %s (%#x) = %#x\n", step, b->name, name, b->phys + offset, value);
+	return value;
+}
+
+static void
+put(struct block *b, const char *name, uint32_t offset, uint32_t value)
+{
+	need(b);
+	printf("SWEET GPU: %u: about to write %s %s at %#x: %#x\n", step, b->name, name, b->phys + offset, value);
+	hold();
+	wr(b->base + offset, value);
+}
+
+static uint32_t
+set(struct block *b, const char *name, uint32_t offset, uint32_t bits)
+{
+	uint32_t was = get(b, name, offset);
+	if ((was & bits) == bits) {
+		return was;
+	}
+	put(b, name, offset, was | bits);
+	return get(b, name, offset);
+}
+
+static bool
+wait_for(struct block *b, uint32_t offset, uint32_t mask, uint32_t value, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if ((rd(b->base + offset) & mask) == value) {
+			return true;
+		}
+		delay(100);
+	}
+	return (rd(b->base + offset) & mask) == value;
+}
+
+/* ---- step 1: clocks from outside, RPMh rails ---- */
+
+/* gcc-atoll.c */
+static struct block gcc = { "gcc", 0x00100000, 0x80000 };
+#define GCC_PLL_VOTE            0x52000         /* bit 15 gcc_gpu_gpll0_clk_src, bit 16 gcc_gpu_gpll0_div_clk_src */
+#define GCC_PLL_VOTE_GPU        (1u << 15)
+#define GCC_PLL_VOTE_GPU_DIV    (1u << 16)
+#define GCC_GPU_CFG_AHB_CBCR    0x71004
+#define GCC_GPU_MEMNOC_GFX_CBCR 0x7100c
+#define GCC_GPU_SNOC_DVM_GFX_CBCR 0x71018
+#define GCC_DDRSS_GPU_AXI_CBCR  0x4452c         /* atoll; redwood's is 0x71154 */
+#define CBCR_ENABLE             (1u << 0)
+#define CBCR_OFF                (1u << 31)
+
+/* reserved-memory cmd-db: the locator at 0xc3f000c (as sweet_rpmh.c) gives its address */
+#define CMD_DB_LOCATOR          0x0c3f000cUL
+#define CMD_DB_SIZE             0x20000UL
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static const struct cmd_db_header *cmd_db;
+
+static uint32_t
+rpmh_resource(const char *name, uint16_t *levels, unsigned *level_count)
+{
+	char id[8] = { 0 };
+	if (level_count != NULL) {
+		*level_count = 0;
+	}
+	if (cmd_db == NULL) {
+		vm_offset_t loc = ml_io_map(CMD_DB_LOCATOR & ~0xfffUL, 0x1000);
+		if (loc == 0) {
+			return 0;
+		}
+		uint64_t pa = rd(loc + (CMD_DB_LOCATOR & 0xfff)) | (uint64_t)rd(loc + (CMD_DB_LOCATOR & 0xfff) + 4) << 32;
+		cmd_db = (const struct cmd_db_header *)ml_io_map_wcomb((vm_offset_t)pa, CMD_DB_SIZE);
+		if (cmd_db == NULL) {
+			return 0;
+		}
+	}
+	const struct cmd_db_header *db = cmd_db;
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+		if (slave->id == 0 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			const uint8_t *data = db->data + slave->data_offset + entry[i].offset;
+			unsigned count = entry[i].length / 2u;
+			if (memcmp(entry[i].id, id, sizeof(id)) != 0) {
+				continue;
+			}
+			if ((unsigned)slave->data_offset + entry[i].offset + entry[i].length > CMD_DB_SIZE - 0x1000) {
+				count = 0;
+			}
+			for (unsigned l = 0; levels != NULL && l < count && l < 16; l++) {
+				levels[l] = (uint16_t)(data[2 * l] | data[2 * l + 1] << 8);
+				if (l > 0 && levels[l] == 0) {
+					break;
+				}
+				*level_count = l + 1;
+			}
+			return entry[i].address;
+		}
+	}
+	return 0;
+}
+
+static void
+show_rpmh_resource(const char *name)
+{
+	uint16_t level[16];
+	unsigned count = 0;
+	uint32_t address = rpmh_resource(name, level, &count);
+	char levels[160];
+	int at = 0;
+	if (address == 0) {
+		printf("SWEET GPU: %u: RPMh has no \"%s\"\n", step, name);
+		return;
+	}
+	levels[0] = 0;
+	for (unsigned l = 0; l < count && at < (int)sizeof(levels) - 8; l++) {
+		at += snprintf(levels + at, sizeof(levels) - (size_t)at, " %u", level[l]);
+	}
+	printf("SWEET GPU: %u: RPMh has \"%s\" at %#x; levels:%s\n", step, name, address, levels);
+}
+
+static bool
+step_outside(void)
+{
+	announce("read the GPU's clocks in the global clock controller");
+	get(&gcc, "pll votes", GCC_PLL_VOTE);
+	get(&gcc, "gpu_cfg_ahb", GCC_GPU_CFG_AHB_CBCR);
+	get(&gcc, "gpu_memnoc_gfx", GCC_GPU_MEMNOC_GFX_CBCR);
+	get(&gcc, "gpu_snoc_dvm_gfx", GCC_GPU_SNOC_DVM_GFX_CBCR);
+	get(&gcc, "ddrss_gpu_axi", GCC_DDRSS_GPU_AXI_CBCR);
+	announce("look up the GPU's supply rails in cmd-db");
+	show_rpmh_resource("gfx.lvl");
+	show_rpmh_resource("cx.lvl");
+	show_rpmh_resource("mx.lvl");
+	return true;
+}
+
+/* ---- step 2: fuses ---- */
+
+/* DT qcom,kgsl-3d0 "qfprom_memory" 0x780000 + 0x6300; kgsl reads the speed bin there (qcom,gpu-speed-bin) */
+static struct block qfprom = { "qfprom", 0x00780000, 0x7000 };
+
+static bool
+step_fuses(void)
+{
+	announce("read the GPU speed-bin fuse area (qfprom 0x780000, the corrected copy at +0x4000)");
+	need(&qfprom);
+	for (uint32_t off = 0x4000 + 0x1e0; off < 0x4000 + 0x200; off += 4) {
+		get(&qfprom, "word", off);
+	}
+	(void)rd8;
+	return true;
+}
+
+/* ---- step 3: the GPU clock controller ---- */
+
+/* DT qcom,gpucc@5090000 ("qcom,atoll-gpucc" = gpucc-sdmmagpie.c); GDSCs 0x509106c (cx), 0x509100c (gx) */
+static struct block gpucc = { "gpucc", 0x05090000, 0x9000 };
+#define GPUCC_PLL0_MODE         0x0000
+#define GPUCC_PLL1_MODE         0x0100
+#define GPUCC_CXO_AON_CBCR      0x1004
+#define GPUCC_GX_GDSCR          0x100c
+#define GPUCC_GX_GMU_CBCR       0x1064
+#define GPUCC_CX_GDSCR          0x106c
+#define GPUCC_AHB_CBCR          0x1078
+#define GPUCC_CX_APB_CBCR       0x1088
+#define GPUCC_CX_SNOC_DVM_CBCR  0x108c
+#define GPUCC_CX_GMU_CBCR       0x1098
+#define GPUCC_CXO_CBCR          0x109c
+#define GPUCC_GMU_RCGR          0x1120
+#define GDSC_SW_COLLAPSE        (1u << 0)
+#define GDSC_HW_CONTROL         (1u << 1)
+#define GDSC_POWER_ON           (1u << 31)
+
+static bool
+step_gpucc(void)
+{
+	announce("make sure the GPU clock controller's register clock runs (gcc_gpu_cfg_ahb)");
+	if ((set(&gcc, "gpu_cfg_ahb", GCC_GPU_CFG_AHB_CBCR, CBCR_ENABLE) & CBCR_OFF) &&
+	    !wait_for(&gcc, GCC_GPU_CFG_AHB_CBCR, CBCR_OFF, 0, 10)) {
+		printf("SWEET GPU: %u: gpu_cfg_ahb stays off (%#x)\n", step, rd(gcc.base + GCC_GPU_CFG_AHB_CBCR));
+		return false;
+	}
+	announce("read the GPU clock controller (0x5090000) as the boot loader left it");
+	get(&gpucc, "cx_gdscr", GPUCC_CX_GDSCR);
+	get(&gpucc, "gx_gdscr", GPUCC_GX_GDSCR);
+	get(&gpucc, "pll0 mode", GPUCC_PLL0_MODE);
+	get(&gpucc, "pll0 l", GPUCC_PLL0_MODE + 4);
+	get(&gpucc, "pll1 mode", GPUCC_PLL1_MODE);
+	get(&gpucc, "gmu_clk_src cmd", GPUCC_GMU_RCGR);
+	get(&gpucc, "gmu_clk_src cfg", GPUCC_GMU_RCGR + 4);
+	get(&gpucc, "cxo_aon", GPUCC_CXO_AON_CBCR);
+	get(&gpucc, "gx_gmu", GPUCC_GX_GMU_CBCR);
+	get(&gpucc, "ahb", GPUCC_AHB_CBCR);
+	get(&gpucc, "cx_apb", GPUCC_CX_APB_CBCR);
+	get(&gpucc, "cx_snoc_dvm", GPUCC_CX_SNOC_DVM_CBCR);
+	get(&gpucc, "cx_gmu", GPUCC_CX_GMU_CBCR);
+	get(&gpucc, "cxo", GPUCC_CXO_CBCR);
+	return true;
+}
+
+/* ---- step 4: CX power ---- */
+
+static bool
+gpucc_answers(void)
+{
+	need(&gcc);
+	need(&gpucc);
+	if (rd(gcc.base + GCC_GPU_CFG_AHB_CBCR) & CBCR_OFF) {
+		printf("SWEET GPU: %u: gpu_cfg_ahb is off (%#x): step 3 first\n", step, rd(gcc.base + GCC_GPU_CFG_AHB_CBCR));
+		return false;
+	}
+	return true;
+}
+
+static bool
+cx_is_on(void)
+{
+	return rd(gpucc.base + GPUCC_CX_GDSCR) & GDSC_POWER_ON;
+}
+
+static bool
+step_cx_power(void)
+{
+	if (!gpucc_answers()) {
+		return false;
+	}
+	announce("switch the CX half of the GPU block on (gpu_cx_gdsc)");
+	uint32_t gdscr = get(&gpucc, "cx_gdscr", GPUCC_CX_GDSCR);
+	if (cx_is_on()) {
+		printf("SWEET GPU: %u: CX is on already\n", step);
+		return true;
+	}
+	if (gdscr & GDSC_HW_CONTROL) {
+		printf("SWEET GPU: %u: the switch is under hardware control: not ours to operate\n", step);
+		return false;
+	}
+	put(&gpucc, "cx_gdscr", GPUCC_CX_GDSCR, gdscr & ~GDSC_SW_COLLAPSE);
+	for (int i = 0; i < 500 && !cx_is_on(); i++) {
+		delay(100);
+	}
+	get(&gpucc, "cx_gdscr", GPUCC_CX_GDSCR);
+	if (!cx_is_on()) {
+		printf("SWEET GPU: %u: CX does not come on\n", step);
+		return false;
+	}
+	printf("SWEET GPU: %u: CX is on\n", step);
+	if (rd(gpucc.base + GPUCC_GX_GDSCR) & GDSC_POWER_ON) {
+		printf("SWEET GPU: %u: the 3D core (GX) has power already: left as it is\n", step);
+	}
+	return true;
+}
+
+/* ---- step 5: clocks ---- */
+
+#define RCG_UPDATE              (1u << 0)
+#define RCG_SOURCE_MASK         0x371fu         /* [4:0] 2*div-1, [10:8] source, [13:12] mode */
+#define RCG_GPLL0_DIV(twice)    (6u << 8 | ((twice) - 1))       /* gpu_cc_parent_map_0: 6 = GPLL0_OUT_MAIN_DIV (300 MHz) */
+
+static bool
+clock_on(struct block *b, const char *name, uint32_t cbcr, bool must)
+{
+	if (!(set(b, name, cbcr, CBCR_ENABLE) & CBCR_OFF) || wait_for(b, cbcr, CBCR_OFF, 0, 10)) {
+		return true;
+	}
+	printf("SWEET GPU: %u: %s %s stays off (%#x)%s\n", step, b->name, name, rd(b->base + cbcr),
+	    must ? "" : "; its status is not one to rely on, going on");
+	return !must;
+}
+
+static bool
+step_clocks(void)
+{
+	if (!gpucc_answers()) {
+		return false;
+	}
+	if (!cx_is_on()) {
+		printf("SWEET GPU: %u: CX is off: step 4\n", step);
+		return false;
+	}
+	announce("global clock controller: the GPLL0 taps for the GPU; the GPU's bus and memory clocks on");
+	set(&gcc, "pll votes", GCC_PLL_VOTE, GCC_PLL_VOTE_GPU | GCC_PLL_VOTE_GPU_DIV);
+	if (!clock_on(&gcc, "gpu_memnoc_gfx", GCC_GPU_MEMNOC_GFX_CBCR, false) ||
+	    !clock_on(&gcc, "gpu_snoc_dvm_gfx", GCC_GPU_SNOC_DVM_GFX_CBCR, false) ||
+	    !clock_on(&gcc, "ddrss_gpu_axi", GCC_DDRSS_GPU_AXI_CBCR, false)) {
+		return false;
+	}
+	announce("GPU clock controller: gmu_clk_src to 200 MHz (GPLL0 main div 300 MHz / 1.5)");
+	uint32_t was = get(&gpucc, "gmu_clk_src cfg", GPUCC_GMU_RCGR + 4);
+	if ((was & RCG_SOURCE_MASK) != RCG_GPLL0_DIV(3)) {
+		put(&gpucc, "gmu_clk_src cfg", GPUCC_GMU_RCGR + 4, (was & ~RCG_SOURCE_MASK) | RCG_GPLL0_DIV(3));
+		put(&gpucc, "gmu_clk_src cmd", GPUCC_GMU_RCGR, rd(gpucc.base + GPUCC_GMU_RCGR) | RCG_UPDATE);
+		if (!wait_for(&gpucc, GPUCC_GMU_RCGR, RCG_UPDATE, 0, 10)) {
+			printf("SWEET GPU: %u: gmu_clk_src does not take its new source (%#x)\n", step,
+			    rd(gpucc.base + GPUCC_GMU_RCGR));
+			return false;
+		}
+		get(&gpucc, "gmu_clk_src cfg", GPUCC_GMU_RCGR + 4);
+	}
+	announce("GPU clock controller: the GMU's clocks and the CX bus clocks on");
+	if (!clock_on(&gpucc, "cxo", GPUCC_CXO_CBCR, true) ||
+	    !clock_on(&gpucc, "ahb", GPUCC_AHB_CBCR, false) ||
+	    !clock_on(&gpucc, "cx_apb", GPUCC_CX_APB_CBCR, false) ||
+	    !clock_on(&gpucc, "cx_snoc_dvm", GPUCC_CX_SNOC_DVM_CBCR, false) ||
+	    !clock_on(&gpucc, "cx_gmu", GPUCC_CX_GMU_CBCR, true)) {
+		return false;
+	}
+	return true;
+}
+
+/* ---- step 6: first words from the GPU block ---- */
+
+/* DT qcom,gmu@506a000 "kgsl_gmu_reg", 0x31000; offsets in words (a6xx_gmu.xml) */
+static struct block gmu = { "gmu", 0x0506a000, 0x31000 };
+#define GMU_WORD(n)             (4u * (n))
+#define GMU_DTCM_VERSIONS       GMU_WORD(0x1c00 + 0xff8)
+#define GMU_CM3_SYSRESET        GMU_WORD(0x5000)
+#define GMU_CM3_BOOT_CONFIG     GMU_WORD(0x5001)
+#define GMU_CM3_FW_INIT_RESULT  GMU_WORD(0x501c)
+#define GMU_CM3_CFG             GMU_WORD(0x502d)
+#define GMU_ALWAYS_ON_COUNTER_L GMU_WORD(0x5088)
+#define GMU_ALWAYS_ON_COUNTER_H GMU_WORD(0x5089)
+#define GMU_SPTPRAC_PWR_CLK_STATUS GMU_WORD(0x50d0)
+#define GMU_RPMH_POWER_STATE    GMU_WORD(0x50ec)
+#define GMU_HFI_CTRL_STATUS     GMU_WORD(0x5180)
+#define GMU_HFI_VERSION_INFO    GMU_WORD(0x5181)
+#define GMU_AO_HOST_INTERRUPT_STATUS GMU_WORD(0x9305)
+#define GMU_RSCC_CONTROL_ACK    GMU_WORD(0x9308)
+#define GMU_AO_GPU_CX_BUSY_STATUS GMU_WORD(0x930c)
+#define GMU_AHB_FENCE_STATUS    GMU_WORD(0x9313)
+
+/* a618 = a630 family: VBIF at word 0x3000 of the 3D core block (a6xx.xml), in the CX half */
+static struct block vbif = { "vbif", 0x05000000 + 4 * 0x3000, 0x1000 };
+#define VBIF_VERSION            (4 * 0x00)
+#define VBIF_CLKON              (4 * 0x01)
+#define VBIF_XIN_HALT_CTRL0     (4 * 0x80)
+#define VBIF_XIN_HALT_CTRL1     (4 * 0x81)
+/* DT "cx_misc" 0x509e000 */
+static struct block cx_misc = { "cx_misc", 0x0509e000, 0x1000 };
+
+static bool
+step_first_words(void)
+{
+	if (!gpucc_answers()) {
+		return false;
+	}
+	uint32_t gmu_clock = rd(gpucc.base + GPUCC_CX_GMU_CBCR);
+	if (!cx_is_on() || (gmu_clock & (CBCR_ENABLE | CBCR_OFF)) != CBCR_ENABLE) {
+		printf("SWEET GPU: %u: needs CX on and cx_gmu running (%#x): steps 4 and 5\n", step, gmu_clock);
+		return false;
+	}
+	announce("read registers of the GMU (0x506a000): the first words from the GPU block itself");
+	get(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET);
+	get(&gmu, "cm3_boot_config", GMU_CM3_BOOT_CONFIG);
+	get(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT);
+	get(&gmu, "cm3_cfg", GMU_CM3_CFG);
+	get(&gmu, "hfi_ctrl_status", GMU_HFI_CTRL_STATUS);
+	get(&gmu, "hfi_version_info", GMU_HFI_VERSION_INFO);
+	get(&gmu, "rpmh_power_state", GMU_RPMH_POWER_STATE);
+	get(&gmu, "sptprac_pwr_clk_status", GMU_SPTPRAC_PWR_CLK_STATUS);
+	get(&gmu, "ao_host_interrupt_status", GMU_AO_HOST_INTERRUPT_STATUS);
+	get(&gmu, "rscc_control_ack", GMU_RSCC_CONTROL_ACK);
+	get(&gmu, "ao_gpu_cx_busy_status", GMU_AO_GPU_CX_BUSY_STATUS);
+	get(&gmu, "ahb_fence_status", GMU_AHB_FENCE_STATUS);
+	get(&gmu, "always_on_counter_h", GMU_ALWAYS_ON_COUNTER_H);
+	uint64_t start = mach_absolute_time(), nanos;
+	uint32_t before = get(&gmu, "always_on_counter_l", GMU_ALWAYS_ON_COUNTER_L);
+	sleep_ms(10);
+	uint32_t hz = rd(gmu.base + GMU_ALWAYS_ON_COUNTER_L) - before;
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &nanos);
+	hz = nanos ? (uint32_t)((uint64_t)hz * NSEC_PER_SEC / nanos) : 0;
+	printf("SWEET GPU: %u: the GMU's counter counts at %u Hz: %s\n", step, hz,
+	    hz > 18000000 && hz < 20500000 ? "the 19.2 MHz crystal: THE GPU BLOCK IS ALIVE" : "not 19.2 MHz");
+	for (uint32_t i = 0; i < 5; i++) {
+		get(&gmu, "dtcm versions", GMU_DTCM_VERSIONS + 4 * i);
+	}
+	announce("read CX misc (0x509e000)");
+	get(&cx_misc, "word 1", 4 * 1);
+	get(&cx_misc, "word 2", 4 * 2);
+	/* Last: on the a630 family it is not certain that the VBIF answers without GX power. */
+	announce("read the GPU's VBIF (0x500c000); if this is the last line, the VBIF needs GX");
+	get(&vbif, "version", VBIF_VERSION);
+	get(&vbif, "clkon", VBIF_CLKON);
+	get(&vbif, "xin_halt_ctrl0", VBIF_XIN_HALT_CTRL0);
+	get(&vbif, "xin_halt_ctrl1", VBIF_XIN_HALT_CTRL1);
+	return true;
+}
+
+/* ---- driver ---- */
+
+static bool (*const steps[])(void) = {
+	NULL, step_outside, step_fuses, step_gpucc, step_cx_power, step_clocks, step_first_words,
+};
+
+static void
+adreno_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t delay_s = 60;
+	(void)PE_parse_boot_argn("sweetgpudelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("sweetgpupause", &pause_ms, sizeof(pause_ms));
+	printf("SWEET GPU: steps 1..%u in %u s\n", last_step, delay_s);
+	sleep_ms(delay_s * 1000);
+	for (step = 1; step <= last_step && step < sizeof(steps) / sizeof(steps[0]); step++) {
+		if (!steps[step]()) {
+			printf("SWEET GPU: step %u failed; stopping\n", step);
+			break;
+		}
+		printf("SWEET GPU: step %u done\n", step);
+	}
+	printf("SWEET GPU: finished\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_adreno_init(void)
+{
+	char board[16] = {0};
+	thread_t thread;
+	(void)PE_parse_boot_argn("sweetgpu", &last_step, sizeof(last_step));
+	if (last_step == 0) {
+		return;
+	}
+	if (!PE_parse_boot_arg_str("sweetboard", board, sizeof(board)) || strcmp(board, "a52q") != 0) {
+		printf("SWEET GPU: addresses are the a52q's; sweetboard=a52q required\n");
+		return;
+	}
+	if (kernel_thread_start(adreno_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
