+#define GMU_DCVS_PERF_SETTING   KGSL_GMU(0x1cbfd)
+#define GMU_DCVS_BW_SETTING     KGSL_GMU(0x1cbfe)
+#define GMU_DCVS_RETURN         KGSL_GMU(0x1cbff)
+#define OOB_GPU                 0
+#define OOB_DCVS                7
+#define ARC_VOTE(pri, sec, vlvl) ((uint32_t)(vlvl) << 16 | (uint32_t)(sec) << 8 | (uint32_t)(pri))
+
+static uint32_t hfi_seq;
+static uint32_t hfi_result[8];
+
+static void
+oob_clear(unsigned request)
+{
+	put(&gmu, "host2gmu_intr_set (oob clear)", GMU_HOST2GMU_INTR_SET, 1u << (24 + request));
+}
+
+/* One message into queue 0, the doorbell, and the GMU's answer from queue 1 (kgsl hfi_send_cmd). */
+static bool
+hfi_send(const char *what, uint32_t id, uint32_t *message, uint32_t words)
+{
+	struct hfi_table *t = (struct hfi_table *)gmu_hfi.memory;
+	uint32_t *cmdq = (uint32_t *)(gmu_hfi.memory + HFI_QUEUE_AT(0));
+	uint32_t *msgq = (uint32_t *)(gmu_hfi.memory + HFI_QUEUE_AT(1));
+	message[0] = (HFI_MSG_CMD << 16 | words << 8 | id) | (++hfi_seq & 0xfff) << 20;
+	to_memory(gmu_hfi.memory, gmu_hfi.size);
+	uint32_t write = t->queue[0].write;
+	for (uint32_t i = 0; i < words; i++) {
+		cmdq[write] = message[i];
+		write = (write + 1) % t->queue[0].words;
+	}
+	t->queue[0].write = write;
+	to_memory(gmu_hfi.memory, gmu_hfi.size);
+	printf("SWEET GPU: %u: HFI %s: %u words, header %#x\n", step, what, words, message[0]);
+	wr(gmu.base + GMU_HOST2GMU_INTR_SET, 1);
+	if (!wait_for(&gmu, GMU_GMU2HOST_INTR_INFO, 1, 1, 200)) {
+		printf("SWEET GPU: %u: HFI %s: no answer (intr_info %#x, cmdq read %u write %u)\n", step, what,
+		    rd(gmu.base + GMU_GMU2HOST_INTR_INFO), t->queue[0].read, t->queue[0].write);
+		return false;
+	}
+	wr(gmu.base + GMU_GMU2HOST_INTR_CLR, 1);
+	bool acked = false;
+	for (int n = 0; n < 8; n++) {
+		to_memory(gmu_hfi.memory, gmu_hfi.size);
+		uint32_t read = t->queue[1].read;
+		if (read == t->queue[1].write) {
+			break;
+		}
+		uint32_t header = msgq[read], size = (header >> 8) & 0xff, got[16] = { 0 };
+		for (uint32_t i = 0; i < size; i++) {
+			if (i < 16) {
+				got[i] = msgq[read];
+			}
+			read = (read + 1) % t->queue[1].words;
+		}
+		t->queue[1].read = read;
+		to_memory(gmu_hfi.memory, gmu_hfi.size);
+		printf("SWEET GPU: %u: HFI from the GMU: %#x %#x %#x %#x %#x\n", step, got[0], got[1], got[2], got[3], got[4]);
+		if (((header >> 16) & 0xf) == HFI_V1_MSG_ACK && got[1] == message[0]) {
+			memcpy(hfi_result, got, sizeof(hfi_result));
+			acked = true;
+		}
+	}
+	if (!acked) {
+		printf("SWEET GPU: %u: HFI %s: no acknowledgement among the answers\n", step, what);
+		return false;
+	}
+	if (hfi_result[2] != 0) {
+		printf("SWEET GPU: %u: HFI %s: the GMU answers error %#x\n", step, what, hfi_result[2]);
+		return false;
+	}
+	return true;
+}
+
+static bool gpu_clocked;
+
+static bool
+step_hfi(void)
+{
+	uint32_t perf = 1;      /* gpu level 1 = 267 MHz */
+	if (!gx_on) {
+		printf("SWEET GPU: %u: needs step 14\n", step);
+		return false;
+	}
+	(void)PE_parse_boot_argn("sweetgpuperf", &perf, sizeof(perf));
+	announce("HFI: INIT (crash dump buffer, cold boot) and FW_VER (kgsl wants 1.8 for a618)");
+	uint32_t init[5] = { 0, 0, GMU_DUMP_ADDRESS, 0x4000, 1 /* kgsl_gmu_core.h GMU_COLD_BOOT */ };
+	if (!hfi_send("init", H2F_MSG_INIT, init, 5)) {
+		return false;
+	}
+	uint32_t ver[2] = { 0, 1u << 28 | 8u << 16 };
+	if (!hfi_send("fw_ver", H2F_MSG_FW_VER, ver, 2)) {
+		return false;
+	}
+	printf("SWEET GPU: %u: GMU firmware version %#x (major %u minor %u)\n", step, hfi_result[3], hfi_result[3] >> 28,
+	    (hfi_result[3] >> 16) & 0xfff);
+
+	/*
+	 * kgsl rpmh_arc_votes_init + setup_volt_dependency_tbl with this phone's cmd-db (boot 0088):
+	 * gfx.lvl 0 16 64 128 192 256 320 384 416, mx.lvl 0 16 256 384, cx.lvl 0 16 64 128 192 256 384;
+	 * GPU levels ascending (DT qcom,gpu-pwrlevels reversed), voltage from gpucc-sdmmagpie rate_max.
+	 */
+	static const uint32_t gpu_khz[8] = { 0, 267000, 355000, 430000, 565000, 650000, 800000, 825000 };
+	static const uint32_t gx_vote[8] = {
+		0, ARC_VOTE(2, 2, 64), ARC_VOTE(3, 2, 128), ARC_VOTE(4, 2, 192), ARC_VOTE(5, 2, 256),
+		ARC_VOTE(6, 3, 320), ARC_VOTE(7, 3, 384), ARC_VOTE(8, 3, 416),
+	};
+	uint32_t perf_table[3 + 2 * 16 + 2 * 4] = { 0 };
+	perf_table[1] = 8;
+	perf_table[2] = 2;
+	for (unsigned i = 0; i < 8; i++) {
+		perf_table[3 + 2 * i] = gx_vote[i];
+		perf_table[3 + 2 * i + 1] = gpu_khz[i];
+	}
+	perf_table[3 + 32 + 2] = ARC_VOTE(2, 2, 64);   /* GMU 200 MHz: VDD_MIN -> cx 64 (idx 2), mx 256 (idx 2) */
+	perf_table[3 + 32 + 3] = 200000;
+	announce("HFI: the DCVS table v1 (8 GPU levels 0..825 MHz, 2 GMU levels)");
+	if (!hfi_send("perf table", H2F_MSG_PERF_TBL, perf_table, sizeof(perf_table) / 4)) {
+		return false;
+	}
+	/* hfi_bwtable_cmd: 6 + 6 + 2*6 + 8 + 16*8 words; one level and no bus commands (DDR is up for the CPU) */
+	uint32_t bw_table[6 + 6 + 12 + 8 + 128] = { 0 };
+	bw_table[1] = 1;
+	announce("HFI: a minimal bandwidth table (one level, no bus commands)");
+	if (!hfi_send("bw table", H2F_MSG_BW_VOTE_TBL, bw_table, sizeof(bw_table) / 4)) {
+		printf("SWEET GPU: %u: the bandwidth table is refused; going on (bus votes stay as they are)\n", step);
+	}
+	uint32_t test[2] = { 0, 0 };
+	announce("HFI: TEST (hfi-use-reg quirk: no more messages until the next boot)");
+	if (!hfi_send("test", H2F_MSG_TEST, test, 2)) {
+		return false;
+	}
+	announce("the GPU clock by register DCVS (kgsl a6xx_gmu_dcvs_nohfi), then OOB gpu to keep it awake");
+	put(&gmu, "dcvs_ack_option", GMU_DCVS_ACK_OPTION, 0);
+	put(&gmu, "dcvs_perf_setting", GMU_DCVS_PERF_SETTING, (perf & 0xff) | 3u << 28);
+	put(&gmu, "dcvs_bw_setting", GMU_DCVS_BW_SETTING, 0);
+	bool dcvs = oob_set(OOB_DCVS);
+	uint32_t ret = get(&gmu, "dcvs_return", GMU_DCVS_RETURN);
+	oob_clear(OOB_DCVS);
+	if (!dcvs) {
+		printf("SWEET GPU: %u: the GMU does not acknowledge the DCVS OOB\n", step);
+		return false;
+	}
+	get(&gpucc, "pll0 mode", GPUCC_PLL0_MODE);
+	get(&gpucc, "pll0 l", GPUCC_PLL0_MODE + 4);
+	get(&gpucc, "gx_gfx3d cbcr", 0x1054);
+	get(&gpucc, "gx_gfx3d rcg cfg", 0x101c + 4);
+	if (!oob_set(OOB_GPU)) {
+		printf("SWEET GPU: %u: the GMU does not acknowledge OOB gpu\n", step);
+		return false;
+	}
+	gpu_clocked = true;
+	printf("SWEET GPU: %u: THE GMU TALKS: tables taken, GPU level %u (%u kHz) asked, return %#x\n", step, perf,
+	    gpu_khz[perf & 7], ret);
+	return true;
+}
