diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 4cdc21b..0fc530b 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -74,6 +74,56 @@ usb_rd(vm_offset_t base, uint32_t off)
 }
 
 static bool sweet_usb_a52q;
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+
+/*
+ * a52q: Samsung ABL leaves the DWC3 clocked but the QUSB2 PHY unconfigured
+ * (boot 0082: ep0 DEPSTARTCFG timed out, host saw a non-responding low-speed
+ * device). Linux phy-msm-qusb-v2.c qusb_phy_init with the atoll live DT:
+ * rails vdd L4A 0.88 V, vdda18 L11A 1.8 V, vdda33 L17A 3.075 V; reset via
+ * GCC_QUSB2PHY_PRIM_BCR 0x26000; power down, qcom,qusb-phy-init-seq, power up,
+ * check PLL_COMMON_STATUS_ONE CORE_READY. No efuse TUNE1 (DT default kept).
+ */
+static void
+usb_a52q_phy_init(vm_offset_t gcc)
+{
+	static const uint16_t seq[][2] = {
+		{0x23, 0x210}, {0x03, 0x04}, {0x7c, 0x18c}, {0x80, 0x2c}, {0x0a, 0x184},
+		{0x19, 0xb4}, {0x40, 0x194}, {0x18, 0x198}, {0x21, 0x214}, {0x08, 0x220},
+		{0x58, 0x224}, {0x46, 0x240}, {0x2b, 0x244}, {0xca, 0x248}, {0x00, 0x24c},
+		{0x03, 0x250}, {0x30, 0x23c}, {0x22, 0x210},
+	};
+	int e1 = sweet_rpmh_vreg_enable("ldoa4", 880);
+	int e2 = sweet_rpmh_vreg_enable("ldoa11", 1800);
+	int e3 = sweet_rpmh_vreg_enable("ldoa17", 3075);
+	printf("SWEET USB: a52q PHY rails L4A=%d L11A=%d L17A=%d (EBUSY = already requested)\n", e1, e2, e3);
+	/* ahb2phy and the PHY clkref branch; ahb2phy is hardware-gated, so its status may read off. */
+	*(volatile uint32_t *)(gcc + 0x6a004) |= 1u;
+	*(volatile uint32_t *)(gcc + 0x8c010) |= 1u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(10);
+	vm_offset_t phy = ml_io_map(0x088e3000, 0x400);
+	if (phy == 0) {
+		printf("SWEET USB: QUSB2 map failed\n");
+		return;
+	}
+	*(volatile uint32_t *)(gcc + 0x26000) |= 1u;      /* assert PHY reset */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(150);
+	*(volatile uint32_t *)(gcc + 0x26000) &= ~1u;     /* deassert */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(20);
+	*(volatile uint32_t *)(phy + 0x210) |= 1u;        /* PWR_CTRL1 power down */
+	for (unsigned i = 0; i < sizeof(seq) / sizeof(seq[0]); i++) {
+		*(volatile uint32_t *)(phy + seq[i][1]) = seq[i][0];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(phy + 0x210) &= ~1u;       /* power up */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(200);
+	printf("SWEET USB: a52q QUSB2 init: PLL_STATUS 0x%02x (bit0 = core ready) PWR_CTRL1 0x%02x TUNE1 0x%02x\n",
+	    usb_rd(phy, 0x1a0) & 0xff, usb_rd(phy, 0x210) & 0xff, usb_rd(phy, 0x240) & 0xff);
+}
 
