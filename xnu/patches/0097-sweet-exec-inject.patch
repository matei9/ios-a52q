+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* one more variable for the programs that get a library inserted (see sweet_inject_env) */
+	if (sweet_inject_env(imgp, sweet_inject, sizeof(sweet_inject))) {
+		error = exec_add_user_string(imgp, CAST_USER_ADDR_T(sweet_inject), UIO_SYSSPACE, TRUE);
+		if (error) {
+			goto bad;
