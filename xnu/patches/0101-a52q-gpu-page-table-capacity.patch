-#define SPACE_TABLES            64
+/*
+ * The core advertises GPU VA 0x20000000..0xffffffff to Mesa. A level-3
+ * table covers 2 MiB: 64 total tables covered less than 124 MiB before
+ * mappings started failing. Allow every table for the first 4 GiB:
+ * 2048 leaf tables + 4 middle tables + root, with three spare entries.
+ * Tables are allocated on demand; this is a descriptor limit, not a
+ * reservation of backing memory. After HackiOS redwood_adreno.c.
+ */
+#define SPACE_TABLES            (2048 + 4 + 1 + 3)
 
 struct gpu_space {
 	const char *name;
