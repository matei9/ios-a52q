+static bool
+step_frame(void)
+{
+	if (!core_free) {
+		printf("SWEET GPU: %u: needs step 19\n", step);
+		return false;
+	}
+	announce("a picture's worth of memory (10 MB) and three bands of colour filled by the 2D engine");
+	if (!block_new(&core_space, &core_target, CORE_TARGET_ADDRESS, TARGET_ROW * TARGET_HEIGHT, PTE_CORE)) {
+		return false;
+	}
+	for (uint32_t i = 0; i < core_space.table_count; i++) {
+		to_memory((vm_offset_t)core_space.tables[i].table, 4096);
+	}
+	ring_command(CP_SET_MARKER, 1);
+	ring(12);
+	ring_register(RB_CCU_CNTL, (0x10000u >> 12) << 21); /* Mesa a6xx gen1 (a618) ccu_offset_bypass 0x10000, COLOR_OFFSET in 4K at bit 21 */
+	ring_fill(0, 800, 255, 128, 0);
+	ring_fill(800, 1600, 255, 255, 255);
+	ring_fill(1600, TARGET_HEIGHT, 0, 128, 255);
+	ring_command(CP_EVENT_WRITE, 4);
+	ring(EVENT_FLUSH_COLOR);
+	ring(CORE_SCRATCH_ADDRESS + 32);
+	ring(0);
+	ring(0x0c0c0c0c);
+	ring_command(CP_EVENT_WRITE, 4);
+	ring(EVENT_CACHE_FLUSH);
+	ring(CORE_SCRATCH_ADDRESS + 16);
+	ring(0);
+	ring(0x0d0e0d0e);
+	ring_command(CP_WAIT_FOR_IDLE, 0);
+	if (!ring_run("fill a picture")) {
+		return false;
+	}
+	to_memory(core_target.memory, core_target.size);
+	const volatile uint8_t *pixel = (const volatile uint8_t *)core_target.memory;
+	printf("SWEET GPU: %u: pixels (BGRA): first %02x %02x %02x %02x (told 00 80 ff ff), middle %02x %02x %02x %02x, "
+	    "last row %02x %02x %02x %02x\n", step, pixel[0], pixel[1], pixel[2], pixel[3],
+	    pixel[1200 * TARGET_ROW + 2160], pixel[1200 * TARGET_ROW + 2161], pixel[1200 * TARGET_ROW + 2162],
+	    pixel[1200 * TARGET_ROW + 2163], pixel[2399 * TARGET_ROW + 4316], pixel[2399 * TARGET_ROW + 4317],
+	    pixel[2399 * TARGET_ROW + 4318], pixel[2399 * TARGET_ROW + 4319]);
+	bool good = pixel[0] == 0x00 && pixel[1] == 0x80 && pixel[2] == 0xff && pixel[1200 * TARGET_ROW + 2160] == 0xff &&
+	    pixel[2399 * TARGET_ROW + 4318] == 0x00 && pixel[2399 * TARGET_ROW + 4316] == 0xff;
+	printf("SWEET GPU: %u: %s\n", step, good ? "THE GPU DRAWS: three bands as told" : "the picture is not as told");
+	return good;
+}
