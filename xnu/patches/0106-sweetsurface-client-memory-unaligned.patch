@@ -858,7 +858,7 @@ RedwoodGPUUserClient::surfaceBuffer(struct redwood_surface * request)
 		return kIOReturnNotFound;
 	}
 	/* SweetSurface: `memory` is the pixels alone (no state page in front, no client-made memory) */
