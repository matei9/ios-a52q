+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: boot-arg sweetinject=LIBRARY,NAME[,NAME...]: every program whose file name is one of the
+ * NAMEs is started with DYLD_INSERT_LIBRARIES=LIBRARY in its environment (the GPU's OpenGL ES
+ * bridge loader in backboardd). launchd refuses DYLD_ variables from a job description, which is
+ * why the kernel adds this one. After HackiOS's kern.exec_inject (OOSEX GANG,
+ * https://github.com/oosexgang/hackios-xnu-kernel, APSL 2.0), set by a boot-arg here.
+ */
+static char sweet_inject_conf[256];
+static int sweet_inject_read;
+
+static bool
+sweet_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	const char *name, *p, *comma;
+	size_t namelen, liblen;
+
+	if (!sweet_inject_read) {
+		if (!PE_parse_boot_arg_str("sweetinject", sweet_inject_conf, sizeof(sweet_inject_conf))) {
+			sweet_inject_conf[0] = 0;
+		}
+		sweet_inject_read = 1;
+	}
+	if (sweet_inject_conf[0] == 0 || imgp->ip_ndp == NULL ||
+	    (comma = strchr(sweet_inject_conf, ',')) == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	liblen = (size_t)(comma - sweet_inject_conf);
+	for (p = comma; *p == ','; ) {
+		const char *word = ++p;
+		while (*p != 0 && *p != ',') {
+			p++;
+		}
+		if (namelen != 0 && (size_t)(p - word) == namelen && strncmp(word, name, namelen) == 0 &&
+		    liblen != 0 && liblen + sizeof("DYLD_INSERT_LIBRARIES=") < size) {
+			size_t used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+			memcpy(env + used, sweet_inject_conf, liblen);
+			env[used + liblen] = 0;
+			return true;
+		}
+	}
+	return false;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
