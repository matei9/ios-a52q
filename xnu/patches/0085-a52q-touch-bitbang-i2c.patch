+/*
+ * a52q: Samsung's QUP firmware puts SE7 in GSI-only mode (GENI_IF_DISABLE_RO
+ * 0x64 bit 0 set, boot 0084), so the FIFO path above cannot run. Bit-bang the
+ * same bus on its pins instead (GPIO function, open drain emulated by output
+ * enable; the board has external pull-ups, DT bias-disable). ~100 kHz, with
+ * clock stretching honoured.
+ */
+#define BB_HALF_US 5u
+
+static void
+bb_line(unsigned pin, bool high)
+{
+	/* Output latch stays 0: high = release (input), low = drive 0. */
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(st.gpio, off) & ~0x200u;
+	touch_wr(st.gpio, off, high ? cfg : (cfg | 0x200u));
+}
+
+static bool
+bb_get(unsigned pin)
+{
+	return touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & 1u;
+}
+
+static bool
+bb_scl_high(void)
+{
+	bb_line(st.bb_scl, true);
+	for (unsigned i = 0; i < 2000; ++i) { /* clock stretching, up to ~2 ms */
+		if (bb_get(st.bb_scl)) {
+			delay(BB_HALF_US);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+bb_setup(unsigned sda, unsigned scl)
+{
+	st.bb_sda = sda;
+	st.bb_scl = scl;
+	st.bb_held = false;
+	for (unsigned pin = 6; pin <= 7; ++pin) {
+		/* GPIO function, no pull, 2 mA, latch 0, released. */
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin), touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u);
+		uint32_t cfg = touch_rd(st.gpio, TOUCH_GPIO_CFG(pin)) & ~0x3ffu;
+		touch_wr(st.gpio, TOUCH_GPIO_CFG(pin), cfg | (0u << 6));
+	}
+	delay(50);
+	/* Bus recovery: clock out a stuck slave, then STOP. */
+	for (unsigned i = 0; i < 9 && !bb_get(st.bb_sda); ++i) {
+		bb_line(st.bb_scl, false);
+		delay(BB_HALF_US);
+		(void)bb_scl_high();
+	}
+	bb_line(st.bb_sda, false);
+	delay(BB_HALF_US);
+	(void)bb_scl_high();
+	bb_line(st.bb_sda, true);
+	delay(BB_HALF_US);
+	printf("SWEET TOUCH: bit-bang I2C sda=gpio%u scl=gpio%u idle sda=%d scl=%d\n",
+	    sda, scl, bb_get(st.bb_sda), bb_get(st.bb_scl));
+}
+
+static bool
+bb_write_byte(uint8_t b)
+{
+	for (int bit = 7; bit >= 0; --bit) {
+		bb_line(st.bb_sda, (b >> bit) & 1u);
+		delay(1);
+		if (!bb_scl_high()) {
+			return false;
+		}
+		bb_line(st.bb_scl, false);
+		delay(BB_HALF_US);
+	}
+	bb_line(st.bb_sda, true); /* release for ACK */
+	delay(1);
+	if (!bb_scl_high()) {
+		return false;
+	}
+	bool ack = !bb_get(st.bb_sda);
+	bb_line(st.bb_scl, false);
+	delay(BB_HALF_US);
+	return ack;
+}
+
+static bool
+bb_read_byte(uint8_t *out, bool ack)
+{
+	uint8_t b = 0;
+	bb_line(st.bb_sda, true);
+	for (int bit = 7; bit >= 0; --bit) {
+		if (!bb_scl_high()) {
+			return false;
+		}
+		b = (uint8_t)((b << 1) | (bb_get(st.bb_sda) ? 1u : 0u));
+		bb_line(st.bb_scl, false);
+		delay(BB_HALF_US);
+	}
+	bb_line(st.bb_sda, !ack);
+	delay(1);
+	if (!bb_scl_high()) {
+		return false;
+	}
+	bb_line(st.bb_scl, false);
+	delay(BB_HALF_US);
+	bb_line(st.bb_sda, true);
+	*out = b;
+	return true;
+}
+
+static void
+bb_stop(void)
+{
+	bb_line(st.bb_sda, false);
+	delay(BB_HALF_US);
+	(void)bb_scl_high();
+	bb_line(st.bb_sda, true);
+	delay(BB_HALF_US);
+	st.bb_held = false;
+}
+
+/* Same contract as touch_msg_run: one direction; stretch = keep the bus for a repeated START. */
+static int
+bb_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	if (nt > 8 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (st.bb_held) {
+		/* Repeated START: SDA high, SCL high, then SDA low. */
+		bb_line(st.bb_sda, true);
+		delay(1);
+		if (!bb_scl_high()) {
+			bb_stop();
+			return ETIMEDOUT;
+		}
+	} else if (!bb_get(st.bb_sda) || !bb_get(st.bb_scl)) {
+		bb_stop();
+		if (!bb_get(st.bb_sda)) {
+			return EBUSY;
+		}
+	}
+	bb_line(st.bb_sda, false); /* START */
+	delay(BB_HALF_US);
+	bb_line(st.bb_scl, false);
+	delay(BB_HALF_US);
+	int err = 0;
+	if (!bb_write_byte((uint8_t)((addr << 1) | (nr ? 1u : 0u)))) {
+		err = ENXIO;
+	}
+	for (unsigned i = 0; !err && i < nt; ++i) {
+		if (!bb_write_byte(tx[i])) {
+			err = EIO;
+		}
+	}
+	for (unsigned i = 0; !err && i < nr; ++i) {
+		if (!bb_read_byte(&rx[i], i + 1 < nr)) {
+			err = ETIMEDOUT;
+		}
+	}
+	st.sent = err ? 0 : nt;
+	st.got = err ? 0 : nr;
+	if (err || !stretch) {
+		bb_stop();
+	} else {
+		st.bb_held = true;
+	}
+	return err;
+}
+
 static int
 touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
     unsigned nr, bool stretch)
 {
+	if (st.bitbang) {
+		int err = bb_msg(addr, tx, nt, rx, nr, stretch);
+		if (st.probing) {
+			printf("SWEET TOUCH: probe bb addr=%#x %s len=%u stretch=%u err=%d\n",
+			    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u, err);
+		}
+		return err;
+	}
 	st.irq_status = st.irq_last = 0;
 	st.sent = st.got = 0;
 	int err = touch_msg_run(addr, tx, nt, rx, nr, stretch);
@@ -717,13 +901,21 @@ touch_thread(void *arg, wait_result_t result)
