+static int
+touch_stm_write(const uint8_t *cmd, unsigned len)
+{
+	return touch_msg(STM_ADDR, cmd, len, NULL, 0, false);
+}
+
+static int
+touch_stm_event(uint8_t *ev)
+{
+	return touch_read(STM_ADDR, STM_READ_ONE, false, ev, STM_EVENT_SIZE);
+}
+
+/* Drain events until one matches (byte0 == want0, byte1 == want1) or the queue is empty. */
+static int
+touch_stm_wait(uint8_t want0, int want1, unsigned tries, const char *what)
+{
+	uint8_t ev[STM_EVENT_SIZE];
+	for (unsigned i = 0; i < tries; ++i) {
+		int err = touch_stm_event(ev);
+		if (err) {
+			printf("SWEET TOUCH: stm %s read err=%d\n", what, err);
+			return err;
+		}
+		if (ev[0] == want0 && (want1 < 0 || ev[1] == (uint8_t)want1)) {
+			printf("SWEET TOUCH: stm %s ok %02x %02x %02x %02x %02x %02x %02x %02x\n", what,
+			    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+			return 0;
+		}
+		if (ev[0] != 0) {
+			printf("SWEET TOUCH: stm %s event %02x %02x %02x %02x %02x %02x %02x %02x\n", what,
+			    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+		}
+		touch_wait(10);
+	}
+	printf("SWEET TOUCH: stm %s: no echo (continuing)\n", what);
+	return ETIMEDOUT;
+}
+
+/* fts_systemreset + fts_init + scan mode, minus firmware update and factory tests. */
+static bool
+touch_stm_start(void)
+{
+	uint8_t id[5] = {0};
+	int err = touch_read(STM_ADDR, STM_READ_ID, false, id, sizeof(id));
+	printf("SWEET TOUCH: stm id err=%d %02x %02x %02x %02x %02x\n",
+	    err, id[0], id[1], id[2], id[3], id[4]);
+	if (err || id[2] != 0x48 || id[3] != 0x36) {
+		return false;
+	}
+	const uint8_t reset[6] = {0xfa, 0x20, 0x00, 0x00, 0x24, 0x81};
+	err = touch_stm_write(reset, sizeof(reset));
+	printf("SWEET TOUCH: stm system reset err=%d\n", err);
+	touch_wait(30);
+	(void)touch_stm_wait(0x09, 0x00, 30, "ready"); /* INFORMATION / READY_STATUS */
+	const uint8_t type[3] = {0x30, 0x61, 0x00}; /* touch | palm | wet */
+	(void)touch_stm_write(type, sizeof(type));
+	touch_wait(10);
+	const uint8_t cal = 0x13; /* FORCE_CALIBRATION, as the vendor probe does */
+	(void)touch_stm_write(&cal, 1);
+	(void)touch_stm_wait(0x43, 0x13, 100, "calibration");
+	const uint8_t clear = 0x62;
+	(void)touch_stm_write(&clear, 1);
+	touch_wait(10);
+	const uint8_t scan[3] = {0xa0, 0x00, 0x01}; /* MS_SS scan = sense on */
+	(void)touch_stm_write(scan, sizeof(scan));
+	(void)touch_stm_wait(0x43, 0xa0, 30, "scan");
+	return true;
+}
+
+static int
+touch_stm(void)
+{
+	uint8_t ev[STM_EVENT_SIZE];
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t down = st.active;
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		x[id] = st.x[id];
+		y[id] = st.y[id];
+	}
+	for (unsigned n = 0; n < 32; ++n) {
+		int err = touch_stm_event(ev);
+		if (err) {
+			return err;
+		}
+		if (ev[0] == 0) {
+			break; /* queue empty */
+		}
+		if ((ev[0] & 3u) == 0) { /* coordinate event */
+			unsigned id = (ev[0] >> 2) & 15u, action = ev[0] >> 6;
+			unsigned px = ((unsigned)ev[1] << 4) | (ev[3] >> 4);
+			unsigned py = ((unsigned)ev[2] << 4) | (ev[3] & 15u);
+			unsigned ttype = ((ev[6] >> 6) << 2) | (ev[7] >> 6);
+			if (id >= TOUCH_MAX) {
+				continue;
+			}
+			if (action == 1u) {
+				printf("SWEET TOUCH: stm down id=%u raw x=%u y=%u type=%u\n", id, px, py, ttype);
+			}
+			if (action == 3u || ttype == 5u) { /* release, or palm */
+				down &= ~(1u << id);
+			} else if (action == 1u || action == 2u) {
+				down |= 1u << id;
+				unsigned sx = px * 1080u / st.stm_max, sy = py * 2400u / st.stm_max;
+				x[id] = (int)(sx > 1079u ? 1079u : sx);
+				y[id] = (int)(sy > 2399u ? 2399u : sy);
+			}
+		} else if ((ev[0] & 3u) == 1u || ev[0] == 0xf3u) {
+			printf("SWEET TOUCH: stm status %02x %02x %02x %02x\n", ev[0], ev[1], ev[2], ev[3]);
+		}
+		if ((ev[7] & 0x1fu) == 0) {
+			break; /* no events left */
+		}
+	}
+	touch_report(down, x, y);
+	return 0;
+}
