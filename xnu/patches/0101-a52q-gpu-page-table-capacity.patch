+	/* Four 4K SMMU tables per 16K XNU page, as in HackiOS. */
+	if (space->table_page == 0 || space->table_page_used == PAGE_SIZE) {
+		if (kmem_alloc(kernel_map, &space->table_page, PAGE_SIZE,
+		    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		space->table_page_used = 0;
+	}
+	vm_offset_t table = space->table_page + space->table_page_used;
+	space->table_page_used += 4096;
+	space->tables[space->table_count].phys = kvtophys(table);
+	space->tables[space->table_count].table = (uint64_t *)table;
 	return space->tables[space->table_count++].table;
 }
 
